# Копирай като server/.env

# AI чатът (docs/chat-api.md): адресът на ai-automation и ключ за достъп, създаден от
# админ на компанията там (API Keys → API access). Ключът стои само в server/.env.
AI_CHAT_API_URL=http://localhost:3847
AI_CHAT_ACCESS_KEY=
# По избор: интеграцията за хора с повече от една (roster или nula_bg).
# AI_CHAT_PROVIDER_KEY=roster
